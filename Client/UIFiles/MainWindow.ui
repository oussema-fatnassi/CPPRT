       <property name="styleSheet">
        <string notr="true">/* QTabWidget General Style */
QTabWidget {
    background-color: #2b2b2b; /* Dark background for the tab widget */
    border: 1px solid #555;    /* Border around the entire widget */
    border-radius: 5px;        /* Rounded corners */
}

/* Tab Bar */
QTabBar::tab {
    background-color: #3c3c3c; /* Tab background */
    color: #ffffff;            /* Tab text color */
    border: 1px solid #555;    /* Border around the tab */
    border-radius: 5px 5px 0 0; /* Rounded top corners for tabs */
    padding: 5px 10px;         /* Padding inside each tab */
    margin: 0 2px;             /* Spacing between tabs */
    font-size: 14px;           /* Font size for tabs */
}

/* Hover Effect for Tabs */
QTabBar::tab:hover {
    background-color: #4c4c4c; /* Lighter background on hover */
}

/* Active Tab */
QTabBar::tab:selected {
    background-color: #555;    /* Background for the active tab */
    color: #ffffff;            /* Text color for the active tab */
    border: 1px solid #666;    /* Border for the active tab */
}

/* Disabled Tab */
QTabBar::tab:disabled {
    background-color: #444;    /* Gray background for disabled tabs */
    color: #888;               /* Light gray text color */
}

/* Content Area */
QTabWidget::pane {
    background-color: #2b2b2b; /* Background for the content area */
    border: 1px solid #555;    /* Border around the content area */
    border-radius: 0px 0px 5px 5px; /* Rounded bottom corners */
    padding: 10px;             /* Padding inside the content area */
}
</string>
